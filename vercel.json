{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "MotoRelease",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:95ZKJeEknRZTd9ECC0CKvaLAYwEY6WwO4ednGbKEmPc=",
    "APP_TIMEZONE": "Asia/Manila",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "QUEUE_CONNECTION": "sync",
    "SMS_DRIVER": "mock"
  }
}
